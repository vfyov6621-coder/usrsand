# sandusr v3.0 configuration

# Telegram API (get from https://my.telegram.org)
API_ID=your_api_id
API_HASH=your_api_hash

# Phone number for first login
PHONE=+79000000000

# Session string (optional, for headless)
SESSION_STRING=

# Web panel port
PORT=8080

# Proxy (if Telegram is blocked in your region)
# Formats: socks5://host:port | socks5://user:pass@host:port | http://host:port
# Requires: pip install python-socks[asyncio]
PROXY=

# Force IPv4 only (set to 0 if VPN handles IPv6 correctly)
FORCE_IPV4=1
